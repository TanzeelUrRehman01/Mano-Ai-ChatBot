# ============================================================
# Mano AI Web — Environment Variables
# Copy this file to .env.local and fill in your API keys
# ============================================================

# --- OpenRouter (FREE) ---
# Sign up at: https://openrouter.ai  (free tier available)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Groq (FREE, Fast) ---
# Sign up at: https://console.groq.com (free tier)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- HuggingFace Inference API (FREE) ---
# Sign up at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Pollinations AI ---
# No key required! Pollinations is completely free with no auth.
# It is used automatically as primary image provider.

# --- App Config ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Mano AI

# --- Default AI Provider (openrouter | groq) ---
DEFAULT_CHAT_PROVIDER=openrouter
